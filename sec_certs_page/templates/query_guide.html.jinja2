{% extends "common/base.html.jinja2" %}
{% set canonical = True %}
{% block title %}
    <title>Query guide | sec-certs.org</title>
{% endblock %}

{% block content %}
<div class="home-container px-3 px-md-4 pt-4 pb-4">
    <main>
        <h1 class="h2">Query syntax guide</h1>
       <p>
            By default, queries are treated as plain text. Multiple terms are combined as a
            <strong>conjunction</strong> (all terms must match) and the query is automatically
            expanded to improve recall. For example, <code>smartcard java</code>
            requires both terms to appear, but documents where they appear together as the exact
            phrase <code>"smartcard java"</code> are ranked higher. If no documents match the
            original terms, the query falls back to prefix matching, so <code>smart</code> can
            also match <code>smartcard</code>.
        </p>
        <p>
            The text search fields also support an advanced query syntax
            described below. As soon as any advanced operator is used, the query is passed to
            the search engine as-is, without any automatic expansion or boosting.
        </p>

        <hr class="my-4">
        <section class="mb-5">
            <h3 id="boolean">Boolean operators</h3>
            <p>
                Use <code>AND</code>, <code>OR</code> to combine terms explicitly.
                <code>AND</code> takes precedence over <code>OR</code>.
            </p>
            <pre class="bg-body-secondary rounded p-3 mb-2">smartcard AND java
TPM OR firmware
(card OR smartcard) AND java</pre>
        </section>

        <section class="mb-5">
            <h3 id="must-exclude">Required and excluded terms</h3>
            <p>
                Prefix a term with <code>+</code> to require it or <code>-</code> to exclude
                it from results. These can be mixed freely. The <code>+</code> and <code>-</code> operators are sufficient on their own to
                express any boolean query. For instance, <code>x AND y OR z</code> can equivalently
                be written as <code>(+x +y) z</code>.
            </p>
            <pre class="bg-body-secondary rounded p-3 mb-2">+secure -network
+smartcard +java -applet</pre>
            <p>
        </section>

        <section class="mb-5">
            <h3 id="phrase">Phrase search</h3>
            <p>
                Wrap terms in double quotes to require them to appear as an
                exact consecutive sequence.
            </p>
            <pre class="bg-body-secondary rounded p-3 mb-2">"secure network"</pre>
        </section>

        <section class="mb-5">
            <h3 id="phrase-slop">Phrase slop</h3>
            <p>
                Append <code>~N</code> to a phrase to allow up to <em>N</em> extra words between
                the quoted terms. For example, <code>"hardware module"~1</code> matches
                "hardware security module".
            </p>
            <pre class="bg-body-secondary rounded p-3 mb-2">"hardware module"~1
"red linux"~2</pre>
        </section>

        <section class="mb-5">
            <h3 id="phrase-prefix">Phrase prefix</h3>
            <p>
                Append <code>*</code> (outside the quotes) to treat the last term in a phrase
                as a prefix — matches any word that starts with it.
            </p>
            <pre class="bg-body-secondary rounded p-3 mb-2">"network access con"*</pre>
        </section>

        <section class="mb-5">
            <h3 id="field-prefix">Field targeting</h3>
            <p>
                Each search input already targets its own field by default. Field prefixes are
                only needed if you want to cross-reference multiple fields from a single box.
            </p>
            <p>
                Every scheme is indexed separately, so the available fields differ between
                Common Criteria (CC), FIPS 140, Protection Profiles (PP) and EUCC. Naming a
                field the current scheme does not have reports a query error.
            </p>
            <p>
                <em>Exact</em> fields are stored untokenized: the value has to match the whole
                stored value, and it must be quoted if it contains spaces — use
                <code>category:"Data Protection"</code>, not <code>category:Data Protection</code>.
            </p>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Field</th>
                            <th scope="col">Type</th>
                            <th scope="col">Schemes</th>
                            <th scope="col">Values</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>name</code></td>
                            <td>text</td>
                            <td>CC, FIPS, PP, EUCC</td>
                            <td>Certificate or module name.</td>
                        </tr>
                        <tr>
                            <td><code>cert_id</code></td>
                            <td>exact</td>
                            <td>CC, EUCC</td>
                            <td>The complete certificate ID, e.g. <code>ANSSI-CC-2023/12</code>.</td>
                        </tr>
                        <tr>
                            <td><code>cert_id_tokenized</code></td>
                            <td>text</td>
                            <td>CC, EUCC</td>
                            <td>
                                The same ID split into words, so parts of it can be matched on their
                                own — <code>cert_id_tokenized:ANSSI</code>. The certificate ID input
                                searches both fields at once.
                            </td>
                        </tr>
                        <tr>
                            <td><code>cert_id</code></td>
                            <td>number</td>
                            <td>FIPS</td>
                            <td>The numeric module ID, e.g. <code>4523</code>.</td>
                        </tr>
                        <tr>
                            <td><code>manufacturer</code></td>
                            <td>text</td>
                            <td>CC</td>
                            <td>Certified product's manufacturer.</td>
                        </tr>
                        <tr>
                            <td><code>vendor</code></td>
                            <td>text</td>
                            <td>FIPS</td>
                            <td>Module's vendor — the FIPS equivalent of <code>manufacturer</code>.</td>
                        </tr>
                        <tr>
                            <td><code>cert_lab</code></td>
                            <td>text</td>
                            <td>CC</td>
                            <td>Evaluation laboratory.</td>
                        </tr>
                        <tr>
                            <td><code>scheme</code></td>
                            <td>exact</td>
                            <td>CC, PP, EUCC</td>
                            <td>Two-letter country code of the certification scheme, e.g. <code>DE</code>, <code>FR</code>, <code>NL</code>.</td>
                        </tr>
                        <tr>
                            <td><code>category</code></td>
                            <td>exact</td>
                            <td>CC, PP</td>
                            <td>Full category name, e.g. <code>"Data Protection"</code> or <code>Databases</code>.</td>
                        </tr>
                        <tr>
                            <td><code>category</code></td>
                            <td>exact</td>
                            <td>FIPS</td>
                            <td>Module type: <code>Hardware</code>, <code>Software</code>, <code>Firmware</code>, <code>Hybrid</code>, <code>Software-Hybrid</code>, <code>Firmware-Hybrid</code>.</td>
                        </tr>
                        <tr>
                            <td><code>eal</code></td>
                            <td>exact</td>
                            <td>CC, EUCC</td>
                            <td><code>EAL1</code> to <code>EAL7</code>, optionally augmented: <code>EAL4+</code>.</td>
                        </tr>
                        <tr>
                            <td><code>level</code></td>
                            <td>exact</td>
                            <td>FIPS</td>
                            <td>Security level as a plain number, matching the Level filter on the search form.</td>
                        </tr>
                        <tr>
                            <td><code>status</code></td>
                            <td>exact</td>
                            <td>CC, PP, EUCC</td>
                            <td><code>active</code>, <code>archived</code>.</td>
                        </tr>
                        <tr>
                            <td><code>status</code></td>
                            <td>exact</td>
                            <td>FIPS</td>
                            <td><code>active</code>, <code>historical</code>, <code>revoked</code>.</td>
                        </tr>
                        <tr>
                            <td><code>not_valid_before</code>, <code>not_valid_after</code></td>
                            <td>date</td>
                            <td>CC, PP, EUCC</td>
                            <td>Certification and archival dates (RFC 3339).</td>
                        </tr>
                        <tr>
                            <td><code>validation_date</code>, <code>sunset_date</code></td>
                            <td>date</td>
                            <td>FIPS</td>
                            <td>Validation and sunset dates (RFC 3339).</td>
                        </tr>
                        <tr>
                            <td><code>body_cert</code>, <code>body_report</code>, <code>body_target</code></td>
                            <td>text</td>
                            <td>CC, EUCC</td>
                            <td>Full text of the certificate, evaluation report and security target.</td>
                        </tr>
                        <tr>
                            <td><code>body_report</code>, <code>body_profile</code></td>
                            <td>text</td>
                            <td>PP</td>
                            <td>Full text of the evaluation report and the protection profile.</td>
                        </tr>
                        <tr>
                            <td><code>body</code></td>
                            <td>text</td>
                            <td>FIPS</td>
                            <td>Full text of the security policy.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p>The document body fields are only searched when the full-text search mode is active.</p>
            <pre class="bg-body-secondary rounded p-3 mb-2">manufacturer:qualcomm
manufacturer:apple AND cert_id_tokenized:ANSSI
scheme:DE AND eal:EAL4+
status:active AND vendor:cisco
category:"Data Protection" AND body_target:keystore
not_valid_before:[2020-01-01T00:00:00Z TO 2023-01-01T00:00:00Z}</pre>
        </section>

        <section class="mb-5">
            <h3 id="set">Set terms</h3>
            <p>
                Match a field against a set of values using the <code>IN</code> operator.
                This is more efficient than writing multiple <code>OR</code> clauses.
            </p>
            <pre class="bg-body-secondary rounded p-3 mb-2">IN [Apple Qualcomm Samsung]</pre>
        </section>

        <section class="mb-5">
            <h3 id="range">Range search</h3>
            <p>
                Specify an inclusive (<code>[</code>, <code>]</code>) or exclusive
                (<code>{</code>, <code>}</code>) range with <code>TO</code> between bounds.
                Works on text fields (lexicographic order) and date fields (RFC 3339).
            </p>
            <pre class="bg-body-secondary rounded p-3 mb-2">
not_valid_before:[2020-01-01T00:00:00Z TO 2023-01-01T00:00:00Z}
[a TO m}</pre>
        </section>


        <section class="mb-5">
            <h3 id="regex">Regular expressions</h3>
            <p>
                Wrap a pattern in forward slashes to use a regex. The regex is matched against
                individual tokens, not the full field value.
            </p>
            <pre class="bg-body-secondary rounded p-3 mb-2">/qual.*/
</pre>
        </section>

        <section class="mb-5">
            <h3 id="boost">Boost</h3>
            <p>
                Append <code>^N</code> to a term or phrase to multiply its relevance score.
                Higher boost values make a match rank higher. Negative boosts are not allowed.
            </p>
            <pre class="bg-body-secondary rounded p-3 mb-2">"TPM"^3 OR smartcard
"secure element"^2 OR "security module"</pre>
        </section>
    </main>
</div>
{% endblock %}
