{% extends "common/base.html.jinja2" %}
{% set canonical = True %}
{% from "include/utils.html.jinja2" import search_box %}
{% block title %}
    <title>Common Criteria | sec-certs.org</title>
{% endblock %}
{% block content %}
    <main class="scheme-home">
        <div class="home-container px-3 px-md-4 pt-md-4">
            <div class="row g-4 justify-content-between mb-4">
                <div class="col-12 col-sm-7">
                    <h1 class="h2 mb-3">Common Criteria</h1>
                    <div style="max-width: 100ch">
                <p>
                    All of the certificates are sourced from the Common Criteria portal at
                    <a href="https://www.commoncriteriaportal.org/" target="_blank" rel="noopener">www.commoncriteriaportal.org</a>.
                    The site provides a CSV file and a HTML listing of the certified products with some metadata.
                    These listings were crawled (along with PDFs of the certificates and security targets) to
                    gather the data provided here.
                </p>
                <p class="mb-0">
                    Search our database for Common Criteria certificates, discover the extracted metadata and
                    keywords, filter them and use other advanced filtering.
                </p>
                    </div>
                </div>
                <div class="col-12 col-sm-5 d-flex justify-content-center align-items-start">
                    <img src="{{ url_for("static", filename="img/cc_logo.svg") }}" alt="Common Criteria"
                         class="part-logo mw-100" style="width: 10em"/>
                </div>
            </div>
        </div>
        {{ search_box("cc", "Search Common Criteria certificates", "Certificate name",
                      url_for('.merged_search'), url_for('.rand')) }}
        <div class="home-band pt-3 pb-3 pb-md-4">
            <div class="home-container px-3 px-md-4">
                <div class="row g-3 row-cols-1 row-cols-md-2 feature-grid" style="--feature-cols: 2">
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-chart-line fa-fw"></i></span>
                                    <h3>Trends and dashboards</h3>
                                </div>
                                <p class="text-body-secondary">Which scheme is issuing certificates the most? Which certificate category is the most numerous? You can find answers in our analysis, or build your own charts in a dashboard.</p>
                                <div class="mt-auto pt-3 d-flex flex-wrap gap-3">
                                    <a href="/dashboard/cc" class="fw-semibold text-decoration-none">
                                        Build a dashboard <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                    <a href="{{ url_for('.analysis') }}" class="fw-semibold text-decoration-none">
                                        See our analysis <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-project-diagram fa-fw"></i></span>
                                    <h3>Cross-references</h3>
                                </div>
                                <p class="text-body-secondary">Are you curious about which certificates reference yours - and vice versa? We automatically link references between certificates to form an extensive network. You can also view detailed reference networks within each certificate's information.</p>
                                <div class="mt-auto pt-3">
                                    <a href="{{ url_for('.network') }}" class="fw-semibold text-decoration-none">
                                        View reference graph <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-clock-rotate-left fa-fw"></i></span>
                                    <h3>Processing updates</h3>
                                </div>
                                <p class="text-body-secondary">What changed the last time we processed the data? Which certificates are new, which ones changed, and which disappeared from the source listing? See our log of weekly processing updates.</p>
                                <div class="mt-auto pt-3">
                                    <a href="{{ url_for('.updates') }}" class="fw-semibold text-decoration-none">
                                        Browse the updates <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-file-alt fa-fw"></i></span>
                                    <h3>Data</h3>
                                </div>
                                <p class="text-body-secondary">Want to process all Common Criteria data on your own? Download our prepared datasets and analyse them.</p>
                                <div class="mt-auto pt-3">
                                    <a href="{{ url_for('.data') }}" class="fw-semibold text-decoration-none">
                                        Download datasets <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
