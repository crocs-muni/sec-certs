{% extends "common/base.html.jinja2" %}
{% set canonical = True %}
{% block title %}
    <title>Common Criteria | sec-certs.org</title>
{% endblock %}

{% block content %}
    <main class="scheme-home">
        <section>
            <div class="col-12 col-sm-10 mx-auto p-3 pt-md-5 pb-md-4">
                <h1>Common Criteria</h1>
                <p class="pt-2">
                    All of the certificates are sourced from the Common Criteria portal at
                    <a href="https://www.commoncriteriaportal.org/" target="_blank" rel="noopener">www.commoncriteriaportal.org</a>.
                    The site provides a CSV file and a HTML listing of the certified products with some metadata.
                    These listings were crawled (along with PDFs of the certificates and security targets) to
                    gather the data provided here.
                </p>
                <p class="pt-2">
                    Search our database for Common Criteria certificates, discover the extracted metadata and
                    keywords, filter them and use other advanced filtering.
                </p>
            </div>
        </section>
        <section class="col-12 col-sm-10 mx-auto p-3" role="search">
            <div class="card shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <h2 class="h5">Search Common Criteria certificates</h2>
                    <form method="get" action="{{ url_for('.merged_search') }}" id="cc-hero-search-form" class="mt-2">
                        <label for="cc-hero-search-input" class="visually-hidden">Search query</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="search" name="query" id="cc-hero-search-input"
                                   class="form-control flex-grow-1"
                                   placeholder="Certificate name, vendor">
                            <button type="submit" class="btn btn-primary flex-shrink-0">
                                <i class="fas fa-search me-1"></i>Search
                            </button>
                        </div>
                    </form>
                    <p class="text-body-secondary small mt-3 mb-0">
                        Nothing specific in mind? Have a look at a
                        <a href="{{ url_for('cc.rand') }}">random certificate</a>.
                    </p>
                </div>
            </div>
        </section>
        <div class="row p-3">
            <div class="col-12 col-sm-10 mx-auto">
                <div class="row g-4 py-3 py-md-4 row-cols-1 row-cols-lg-2">
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="feature-icon-sm bg-primary bg-gradient mb-0"><i class="fas fa-chart-bar fa-fw"></i></div>
                                    <h3 class="h5 mb-0">Statistics Analysis</h3>
                                </div>
                                <p class="flex-grow-1">Which scheme is issuing certificates the most? Which certificate category is the most numerous? You can find answers here and you can also make your own statistics with our prepared datasets.</p>
                                <div>
                                    <a href="{{ url_for('.analysis') }}" class="btn btn-primary">Explore statistics →</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="feature-icon-sm bg-primary bg-gradient mb-0"><i class="fas fa-project-diagram fa-fw"></i></div>
                                    <h3 class="h5 mb-0">Cross-references</h3>
                                </div>
                                <p class="flex-grow-1">Are you curious about which certificates reference yours - and vice versa? We automatically link references between certificates to form an extensive network. You can also view detailed reference networks within each certificate's information.</p>
                                <div>
                                    <a href="{{ url_for('.network') }}" class="btn btn-primary">View reference graph →</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-10 mx-auto p-3 pb-md-5">
            <div class="card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="feature-icon-sm bg-primary bg-gradient mb-0">
                            <i class="fas fa-file-alt fa-fw"></i>
                        </div>
                        <h2 class="mb-0">Data</h2>
                    </div>
                    <p>Want to process all Common Criteria data on your own? Download our prepared datasets and analyse them.</p>
                    <a href="{{ url_for('.data') }}" class="btn btn-primary">Download datasets →</a>
                </div>
            </div>
        </div>

    </main>
{% endblock %}
