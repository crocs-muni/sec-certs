{% from "include/entry.html.jinja2" import entry_card, render_local_cert, render_local_report, render_local_target, render_file_metadata, render_frontpage, render_references %}
{% from "include/utils.html.jinja2" import render_process_state %}
{% from "cc/include.html.jinja2" import render_keywords, render_status %}

{% call entry_card(id="st-info", title="Security target", icon="fa-file-alt") %}
    <div>
        {{ render_process_state(cert["state"], cert["st_link"], "st", "security target") }}
    </div>

    {% if cert["st_link"] %}
        <div>
            {{ render_local_target(hashid, local_files, cert["st_link"], primary_style="btn-primary", secondary_style="btn-secondary") }}
        </div>
    {% endif %}

    {{ render_keywords(cert["pdf_data"]["st_keywords"], "target") }}

    <div>
        {{ render_references(network, hashid, "st", render_status) }}
    </div>

    <div>
        {{ render_file_metadata(cert["pdf_data"]["st_metadata"], "Security target", "st") }}
    </div>
{% endcall %}
