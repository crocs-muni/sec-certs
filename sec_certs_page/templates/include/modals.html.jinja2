{% macro compare_icon() %}
    <span id="compare" class="position-relative d-inline-block">
        <button id="compare-icon" class="btn btn-primary text-nowrap" title="Compare certificates"
                data-bs-toggle="modal" data-bs-target="#compare-modal">
            <i class="fas fa-fw fa-scale-balanced" aria-hidden="true"></i>
            <span id="compare-pill"
                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                &nbsp;
                    <span class="visually-hidden">selected certificates for comparison</span>
            </span>
            Compare
        </button>
    </span>
{% endmacro %}

{% macro compare_modal() %}
    <div class="modal fade" id="compare-modal" tabindex="-1" aria-labelledby="compare-modal-label"
         aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="compare-modal-label">Compare certificates</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="compare-none">
                        You currently have no selected certificates for comparison. Add certificates on the page
                        of the certificate. After you do so you will be able to
                        see them here and compare them.
                    </p>
                    <div id="compare-some" style="display: none">
                        <table class="table">
                            <tbody></tbody>
                        </table>
                        You can compare two certificates.
                    </div>
                    <p class="invalid-feedback" id="compare-error"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button id="compare-add-current" class="btn btn-primary" style="display: none"><i
                            class="fas fa-plus"></i>
                        Add current certificate
                    </button>
                    <button id="compare-do" class="btn btn-primary">Compare
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro modal_script() %}
    <script type="module">
        import {
            add_current_cert,
            update_state,
            compare_do,
            chat
        } from "{{ url_for('static', filename='modal.js') }}?{{ static_hash("modal.js") }}";

        let chat_history = [];

        $(function () {
            {% if config["CHAT_ENABLED"] %}
                if (window.location.href.indexOf("#chat") !== -1) {
                    let chatModal = new bootstrap.Modal(document.getElementById("chat-modal"));
                    chatModal.show();
                }
                function chatToggleSend() {
                    let input = $("#chat-input");
                    if (!input.length) {
                        return;
                    }
                    $("#chat-send").prop("disabled", input.val().trim() === "");
                }
                function chatResize(el) {
                    el.style.height = "auto";
                    el.style.height = Math.min(el.scrollHeight, 160) + "px";
                    el.style.overflowY = el.scrollHeight > 160 ? "auto" : "hidden";
                }
                $("#chat-input").on("input", function () {
                    chatResize(this);
                    chatToggleSend();
                });
                $("#chat-modal").on("shown.bs.modal", function () {
                    let el = document.getElementById("chat-input");
                    if (el) {
                        chatResize(el);
                        el.focus();
                    }
                });
                $(document).on("click", ".chat-sug", function () {
                    $("#chat-input").val($(this).text()).trigger("input").focus();
                });
                $(document).on("click", ".chat-about-item", function () {
                    $("#chat-about").val($(this).data("value"));
                    $("#chat-about-label").text($(this).data("label"));
                    $(".chat-about-item").removeClass("active");
                    $(this).addClass("active");
                    bootstrap.Dropdown.getOrCreateInstance(document.getElementById("chat-about-btn")).hide();
                });
                $(document).on("click", ".chat-model-item", function () {
                    $("#chat-model").val($(this).data("value"));
                    $("#chat-model-label").text($(this).data("value"));
                    $(".chat-model-item").removeClass("active");
                    $(this).addClass("active");
                    bootstrap.Dropdown.getOrCreateInstance(document.getElementById("chat-model-btn")).hide();
                });
                $("#chat-send").click(function () {
                    let full_url = "{{ url_for("chat.query_full") }}";
                    let token = "{{ csrf_token() }}";
                    chat(full_url, token, chat_history, window.certificate_data);
                });
                $("#chat-reset").click(function () {
                    chat_history = [];
                    $("#chat-messages").empty();
                    $("#chat-empty").removeClass("d-none");
                    $("#chat-error").hide();
                    $("#chat-input").val("").trigger("input");
                });
                $("#chat-input").keypress(function (event) {
                    if (event.key === "Enter" && !event.ctrlKey && !event.shiftKey) {
                        event.preventDefault();
                        if (!$("#chat-send").prop("disabled")) {
                            $("#chat-send").click();
                        }
                    }
                });
                $("#chat-fullscreen-btn").click(function () {
                    $("#chat-modal .modal-dialog").toggleClass("modal-xl").toggleClass("modal-fullscreen");
                });
                chatToggleSend();
            {% endif %}
            $("#compare-modal").on("show.bs.modal", function () {
                update_state();
            });
            $("#compare-add-current").click(function () {
                add_current_cert("selected_certs_comparison", window.certificate_data);
            });
            $("#compare-do").click(function () {
                let cc_url = "{{ url_for("cc.compare", one_hashid="XXXXXXXXXXXXXXXX", other_hashid="YYYYYYYYYYYYYYYY") }}";
                let fips_url = "{{ url_for("fips.compare", one_hashid="XXXXXXXXXXXXXXXX", other_hashid="YYYYYYYYYYYYYYYY") }}";
                let eucc_url = "{{ url_for("eucc.compare", one_hashid="XXXXXXXXXXXXXXXX", other_hashid="YYYYYYYYYYYYYYYY") }}";
                compare_do(cc_url, fips_url, eucc_url);
            });
            update_state();
        })
    </script>
{% endmacro %}

{% macro chat_icon() %}
    <button id="chat-icon" class="btn btn-primary text-nowrap" title="Ask AI about this certificate"
            data-bs-toggle="modal" data-bs-target="#chat-modal">
        <i class="fas fa-fw fa-message" aria-hidden="true"></i>
        Ask AI
    </button>
{% endmacro %}
{% macro chat_modal() %}
    <div class="modal fade" id="chat-modal" tabindex="-1" aria-labelledby="chat-modal-label"
         aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="chat-modal-label">Chat</h5>
                    <div class="ms-auto d-flex align-items-center gap-1">
                        {% if current_user.is_authenticated %}
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="chat-reset"
                                    title="Start a new chat">
                                <i class="fas fa-pen-to-square me-1"></i>New
                            </button>
                        {% endif %}
                        <button type="button" class="btn bg-body text-secondary" id="chat-fullscreen-btn"
                                title="Toggle fullscreen">
                            <i class="fas fa-expand"></i>
                        </button>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body" id="chat-body">
                    <p class="invalid-feedback" id="chat-error" style="display: none"></p>
                    <!-- Chat skeleton start -->
                    {% if not current_user.is_authenticated %}
                        <div class="alert alert-info" role="alert">
                            Chat is available to authorized users only. Please log in to use this feature.
                        </div>
                    {% else %}
                        {% set placeholders = ["Describe this certificate.",
                                           "What is the certificate ID of this certificate?",
                                           "What other certified products are referenced by this certificate?",
                                           "Which evaluation facility performed the evaluation of this certificate?",
                                           "When was this product certified?"] %}
                        <div id="chat-skeleton">
                            <div id="chat-window">
                                <div id="chat-empty" class="chat-empty">
                                    <span class="chat-empty-glyph"><i class="fas fa-message"></i></span>
                                    <h2 class="chat-empty-title">Ask about this certificate</h2>
                                    <p class="small text-secondary mb-0">Answers come from the certification report and
                                        security target only. Try one of these:</p>
                                    <div class="chat-sugs">
                                        {% for placeholder in placeholders %}
                                            <button type="button" class="chat-sug small">{{ placeholder }}</button>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div id="chat-messages"></div>
                            </div>
                            <div class="chat-composer">
                                <textarea id="chat-input" class="chat-textarea" rows="1"
                                          placeholder="Ask about this certificate…"></textarea>
                                <div class="chat-composer-tools">
                                    <div class="chat-tool-opts">
                                        <span class="small fw-semibold text-secondary text-nowrap">Chat context:</span>
                                        <div class="dropdown dropup">
                                            <button class="form-select text-start w-auto chat-tool-select"
                                                    type="button" id="chat-about-btn" data-bs-toggle="dropdown"
                                                    aria-expanded="false" aria-label="Chat context">
                                                <span id="chat-about-label">All documents</span>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="chat-about-btn">
                                                <li><button type="button" class="dropdown-item chat-about-item active"
                                                            data-value="full-both" data-label="All documents">
                                                    All documents
                                                    <span class="chat-item-desc">Certification report + security target</span></button></li>
                                                <li><button type="button" class="dropdown-item chat-about-item"
                                                            data-value="full-report" data-label="Certification report">
                                                    Certification report
                                                    <span class="chat-item-desc">Certification report</span></button></li>
                                                <li><button type="button" class="dropdown-item chat-about-item"
                                                            data-value="full-target" data-label="Security target">
                                                    Security target
                                                    <span class="chat-item-desc">Security target</span></button></li>
                                            </ul>
                                        </div>
                                        <input type="hidden" id="chat-about" value="full-both">
                                        <span class="small fw-semibold text-secondary text-nowrap">Model:</span>
                                        <div class="dropdown dropup">
                                            <button class="form-select text-start w-auto chat-tool-select"
                                                    type="button" id="chat-model-btn" data-bs-toggle="dropdown"
                                                    aria-expanded="false" aria-label="Model">
                                                <span id="chat-model-label">{{ config["WEBUI_DEFAULT_MODEL"] }}</span>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="chat-model-btn">
                                                {% for model in config["WEBUI_MODELS"] %}
                                                    <li><button type="button"
                                                                class="dropdown-item chat-model-item{% if model == config['WEBUI_DEFAULT_MODEL'] %} active{% endif %}"
                                                                data-value="{{ model }}">{{ model }}</button></li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                        <input type="hidden" id="chat-model" value="{{ config['WEBUI_DEFAULT_MODEL'] }}">
                                    </div>
                                    <button id="chat-send" class="chat-send" type="button" disabled aria-label="Send">
                                        <i class="fas fa-arrow-up"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mt-2">
                                <span class="small text-secondary">Chat uses AI. Check for mistakes. Powered
                                    by <a href="https://docs.cerit.io/en/docs/ai-as-a-service/chat-ai" target="_blank"
                                          rel="noopener">e-Infra</a>.</span>
                            </div>
                        </div>
                    {% endif %}
                    <!-- Chat skeleton end -->
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
