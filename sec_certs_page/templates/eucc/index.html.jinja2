{% extends "common/base.html.jinja2" %}
{% set canonical = True %}
{% block title %}
    <title>EUCC | sec-certs.org</title>
{% endblock %}

{% block content %}
    <main class="scheme-home">
        <section>
            <div class="col-12 col-sm-10 mx-auto p-3 py-md-5">
                <h1>EUCC</h1>
                <p class="pt-2">
                    The EU Cybersecurity Certification Scheme on Common Criteria (EUCC) certificates are sourced from the EUCC portal at
                    <a href="https://certification.enisa.europa.eu/"
                       target="_blank" rel="noopener">certification.enisa.europa.eu</a>.
                    The site provides certificates, each accompanied by a metadata table. These listings, along with
                    associated artifacts such as reports, security targets, and the certificates themselves, were
                    scraped to gather the data provided here.
                </p>
            </div>
        </section>
        <section class="col-12 col-sm-10 mx-auto p-3" role="search">
            <div class="card shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <h2 class="h5">Search EUCC certificates</h2>
                    <p class="mb-0">We are converting all EUCC certificates from PDFs into machine readable format.
                        Search our database for any EUCC certificate, discover its extracted metadata, filter them
                        and do much more.</p>
                    <form method="get" action="{{ url_for('.merged_search') }}" id="eucc-hero-search-form" class="mt-2">
                        <label for="eucc-hero-search-input" class="visually-hidden">Search query</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="search" name="query" id="eucc-hero-search-input"
                                   class="form-control flex-grow-1"
                                   placeholder="Certificate name, vendor">
                            <button type="submit" class="btn btn-primary flex-shrink-0">
                                <i class="fas fa-search me-1"></i>Search
                            </button>
                        </div>
                    </form>
                    <p class="text-body-secondary small mt-3 mb-0">
                        Nothing specific in mind? Have a look at an
                        <a href="{{ url_for('eucc.entry', hashid='5446f38f4b9c9869') }}">example certificate</a>
                        or open a <a href="{{ url_for('eucc.rand') }}">random one</a>.
                    </p>
                </div>
            </div>
        </section>
        <div class="col-12 col-sm-10 mx-auto p-3 pb-md-5">
            <div class="card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="feature-icon-sm bg-primary bg-gradient mb-0">
                            <i class="fas fa-file-alt fa-fw"></i>
                        </div>
                        <h2 class="mb-0">Data</h2>
                    </div>
                    <p>Want to process all EUCC data on your own? Download our prepared datasets and analyse them.</p>
                    <a href="{{ url_for('.data') }}" class="btn btn-primary">Download datasets →</a>
                </div>
            </div>
        </div>

    </main>
{% endblock %}
