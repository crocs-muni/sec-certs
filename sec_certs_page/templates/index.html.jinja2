{% extends "common/base.html.jinja2" %}
{% set canonical = True %}
{% set search_scopes = [
    ("cc", "Common Criteria", url_for("cc.merged_search"), "Certificate name", url_for("cc.rand")),
    ("eucc", "EUCC", url_for("eucc.merged_search"), "Certificate name", url_for("eucc.rand")),
    ("pp", "Protection Profiles", url_for("pp.merged_search"), "Profile name", url_for("pp.rand")),
    ("fips", "FIPS 140", url_for("fips.merged_search"), "Module name", url_for("fips.rand")),
] %}
{% set scheme_links = {
    "search": {"cc": url_for("cc.merged_search"), "eucc": url_for("eucc.merged_search"),
               "pp": url_for("pp.merged_search"), "fips": url_for("fips.merged_search")},
    "network": {"cc": url_for("cc.network"), "fips": url_for("fips.network")},
    "analysis": {"cc": url_for("cc.analysis"), "fips": url_for("fips.analysis")},
    "data": {"cc": url_for("cc.data"), "eucc": url_for("eucc.data"),
             "pp": url_for("pp.data"), "fips": url_for("fips.data")},
} %}
{% macro scheme_link(feature, label) %}
    <div class="mt-auto pt-3">
        <a href="{{ scheme_links[feature]["cc"] }}" class="fw-semibold text-decoration-none" data-scheme-link
           {%- for scheme, url in scheme_links[feature].items() %} data-{{ scheme }}="{{ url }}"{% endfor %}>
            {{ label }} <i class="fas fa-arrow-right fa-xs ms-1"></i>
        </a>
    </div>
{%- endmacro %}
{% set search_examples = {
    "cc": ["ShadowCube V8.0", "Apple macOS 26 Tahoe", "RICOH IM 7010", "Progress LoadMaster"],
    "eucc": ["ST54J / ST54K", "NPCT7xx TPM2.0 rev 1.59", "Huawei ATN Series Routers"],
    "pp": ["PP-Module for SDN Controller", "Protection Profile for Virtualization"],
    "fips": ["Acme Packet VME", "NetScaler MPX", "nShield 5s Hardware Security Module"],
} %}
{% block content %}
    <main class="main-home">
        <div class="home-container px-3 px-md-4 pt-md-4 pb-3">
            <div class="row g-4 justify-content-between align-items-center mb-4">
                <div class="col-12 col-sm-7">
                    <h1 class="h2 mb-3">What is sec-certs?</h1>
                    <div style="max-width: 100ch">
                        <p>
                            We want to become the one-stop shop to explore the
                            <a href="{{ url_for("cc.index") }}">Common Criteria</a>,
                            <a href="{{ url_for("eucc.index") }}">EUCC</a> and
                            <a href="{{ url_for("fips.index") }}">FIPS 140</a>
                            certification ecosystem. We aggregate and annotate certification data, enabling you to
                            perform unified searches,
                            investigate <a href="{{ url_for("vuln.index") }}">vulnerabilities</a>,
                            analyze <a href="/dashboard/">trends</a>,
                            compare
                            <a href="{{ url_for("cc.compare", one_hashid="a5171efab0a32451", other_hashid="0b0b999b8665313b") }}">products</a>
                            side-by-side, subscribe to certificate changes, and take other actions on certified
                            products.
                        </p>
                        <p class="mb-0">
                            The sec-certs tool is an ongoing research project by the
                            <a href="https://crocs.fi.muni.cz" target="_blank" rel="noopener">Centre for Research on
                                Cryptography and Security (CRoCS)</a> at
                            <a href="https://www.muni.cz/en" target="_blank" rel="noopener">Masaryk University</a>.
                            Learn more about our
                            <a href="{{ url_for("about.index") }}">team</a>
                            and
                            <a href="{{ url_for("about.research") }}">research</a>.
                        </p>
                    </div>
                </div>
                <div class="col-12 col-sm-5 d-flex justify-content-center">
                    <img src="{{ url_for("static", filename="img/logo.svg") }}" alt="sec-certs"
                         class="d-none d-xl-block mw-100" width="520"
                         style="filter: drop-shadow(0px 8px 16px rgba(0, 0, 0, 0.15)); margin: 2em 0;"/>
                    <img src="{{ url_for("static", filename="img/logo_badge.svg") }}" alt="sec-certs"
                         class="d-xl-none mw-100"
                         style="filter: drop-shadow(0px 8px 16px rgba(0, 0, 0, 0.15));"/>
                </div>
            </div>

            <section role="search">
                <h2 class="h5 mb-3">Search security certificates</h2>


                <ul class="nav nav-tabs search-tabs mb-0" aria-label="Certification scheme">
                    {% for scheme, label, action, placeholder, random_url in search_scopes %}
                        <li class="nav-item">
                            <a class="nav-link{% if loop.first %} active{% endif %}"
                               {% if loop.first %}aria-current="page"{% endif %}
                               href="#" data-search-scope data-scheme="{{ scheme }}"
                               data-action="{{ action }}" data-placeholder="{{ placeholder }}"
                               data-random="{{ random_url }}">{{ label }}</a>
                        </li>
                    {% endfor %}
                </ul>
                <div class="card shadow-sm mb-0 rounded-top-0">
                    <div class="card-body p-3 p-md-4 pb-3 pb-md-3">
                        <form method="get" action="{{ search_scopes[0][2] }}" id="home-search-form">
                            <div class="d-flex gap-2 align-items-center">
                                <label for="home-search" class="visually-hidden">Search query</label>
                                <input id="home-search" name="query" type="search"
                                       class="form-control flex-grow-1"
                                       placeholder="{{ search_scopes[0][3] }}"/>
                                <button type="submit" class="btn btn-primary flex-shrink-0">
                                    <i class="fas fa-search me-1"></i>Search
                                </button>
                            </div>
                            <div class="mt-3">
                                <a href="{{ search_scopes[0][4] }}" id="home-random"
                                   class="text-muted small d-inline-flex align-items-center gap-1">
                                    <i class="fas fa-shuffle"></i>Nothing specific in mind? Open a random certificate
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
        </div>

        <div class="home-band pt-3 pb-3 pb-md-4">
            <div class="home-container px-3 px-md-4">
                <h2 class="h5 mb-3">Main features</h2>
                <div class="row g-3 row-cols-1 row-cols-md-2 feature-grid">
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-search fa-fw"></i></span>
                                    <h3>Unified search</h3>
                                </div>
                                <p class="text-body-secondary">
                                    Search certificates relevant for your product, filter
                                    certificates by categories or status.
                                    Explore the certificates without downloading and reading countless PDFs.
                                </p>
                                <p class="text-body-secondary">
                                    We download and process certificates
                                    <a href="{{ url_for("cc.updates") }}">weekly</a>, allowing you to search for your
                                    favorite Common Criteria, EUCC and FIPS 140 products.
                                </p>
{{ scheme_link("search", "Search certificates") }}
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-comments fa-fw"></i></span>
                                    <h3>Explore certificates with AI</h3>
                                </div>
                                <p class="text-body-secondary">
                                    Use our AI assistant to help you explore and understand
                                    Common Criteria, EUCC and FIPS 140 certificates. Ask questions about a certificate
                                    and let the AI guide you through the complex certification documents.
                                </p>
{{ scheme_link("search", "Pick a certificate") }}
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-bug fa-fw"></i></span>
                                    <h3>Vulnerability investigation</h3>
                                </div>
                                <p class="text-body-secondary">
                                    Investigate the vulnerabilities affecting certified products.
                                </p>
                                <p class="text-body-secondary">
                                    We automatically map certificates to <abbr
                                        title="Common Vulnerabilities and Exposures">CVE</abbr>
                                    entries in NIST's National Vulnerability Database affecting them.
                                    The information on relevant CVEs is displayed in the appropriate heuristics section
                                    on pages of the affected certificates.
                                </p>
                                <div class="mt-auto pt-3">
                                    <a href="{{ url_for("vuln.cve_search") }}" class="fw-semibold text-decoration-none">
                                        Browse vulnerabilities <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-chart-line fa-fw"></i></span>
                                    <h3>Trends and dashboards</h3>
                                </div>
                                <p class="text-body-secondary">
                                    We process certification PDFs into structured, machine-readable datasets and chart
                                    them, so you can see how the certification landscape evolves.
                                </p>
                                <p class="text-body-secondary">
                                    Browse our prepared analysis, or build a dashboard of your own: pick a collection,
                                    add predefined or custom charts and save it for later. The analysis shows
                                    preliminary findings - refer to our published
                                    <a href="{{ url_for("about.research") }}">research</a> for a more detailed
                                    analysis.
                                </p>
                                <div class="mt-auto pt-3 d-flex flex-wrap gap-3">
                                    <a href="/dashboard/" class="fw-semibold text-decoration-none">
                                        Build a dashboard <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                    <a href="{{ scheme_links["analysis"]["cc"] }}"
                                       class="fw-semibold text-decoration-none" data-scheme-link
                                       {%- for scheme, url in scheme_links["analysis"].items() %} data-{{ scheme }}="{{ url }}"{% endfor %}>
                                        See our analysis <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-network-wired fa-fw"></i></span>
                                    <h3>Certificate references</h3>
                                </div>
                                <p class="text-body-secondary">
                                    Explore the references between product
                                    certificates in a graph. A certificate referencing
                                    another certificate often means that its product is built atop of another security
                                    relevant product.
                                </p>
                                <p class="text-body-secondary">
                                    We use regular expressions to create references between certificates, making it easy
                                    for you to find relationships in our reference graphs or certificate details.
                                </p>
{{ scheme_link("network", "View reference graphs") }}
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-file-alt fa-fw"></i></span>
                                    <h3>Open data</h3>
                                </div>
                                <p class="text-body-secondary">
                                    Each week, we collect thousands of certificate files, convert them into
                                    machine-readable datasets, and enrich them with additional metadata.
                                </p>
                                <p class="text-body-secondary">
                                    Full datasets are available below, while individual certificate data can be
                                    accessed on each certificate's page.
                                </p>
                                <div class="mt-auto pt-3">
                                    <a href="{{ scheme_links["data"]["cc"] }}"
                                       class="fw-semibold text-decoration-none" data-scheme-link
                                       {%- for scheme, url in scheme_links["data"].items() %} data-{{ scheme }}="{{ url }}"{% endfor %}>
                                        Download datasets <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-code fa-fw"></i></span>
                                    <h3>Python library</h3>
                                </div>
                                <p class="text-body-secondary">
                                    Everything on this site is built with our open-source Python library. Install it to
                                    reproduce the datasets yourself, or plug the certification data straight into your
                                    own analysis.
                                </p>
                                <p class="text-body-secondary">
                                    The documentation includes a quick-start guide, and the code is open to
                                    contributions.
                                </p>
                                <div class="mt-auto pt-3 d-flex flex-wrap gap-3">
                                    <a href="{{ url_for("docs.serve_docs", path="index.html") }}"
                                       class="fw-semibold text-decoration-none">
                                        Read the docs <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                    <a href="https://github.com/crocs-muni/sec-certs" target="_blank" rel="noopener"
                                       class="fw-semibold text-decoration-none">
                                        View the code <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-envelope fa-fw"></i></span>
                                    <h3>Change notifications</h3>
                                </div>
                                <p class="text-body-secondary">
                                    Subscribe to notifications about a vulnerability affecting a set of
                                    certified products, all changes in a set of certified products or about new
                                    certificates.
                                </p>
                                <p class="text-body-secondary">
                                    As a registered user, you can subscribe using the <span class="fa-stack fa-2x"
                                                                                            style="font-size: 0.8rem">
                                    <i class="fas fa-square fa-stack-2x text-secondary"
                                       style="vertical-align: middle"></i>
                                    <i class="fas fa-envelope fa-stack-1x text-light"
                                       style="vertical-align: middle"></i>
                                </span> button in certificate details.
                                </p>
                                {#
                                <p>Alternatively, use the update feed button <span class="fa-stack fa-2x"
                                                                                   style="font-size: 0.8rem">
                                    <i class="fas fa-square fa-stack-2x text-secondary"
                                       style="vertical-align: middle"></i>
                                    <i class="fas fa-feed fa-stack-1x text-light"
                                       style="vertical-align: middle"></i>
                                </span> to get an ATOM feed of updates to a certificate.
                                </p>
                             #}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            (() => {
                const form = document.getElementById("home-search-form");
                const input = document.getElementById("home-search");
                const random = document.getElementById("home-random");
                const tabs = document.querySelectorAll("[data-search-scope]");
                if (!form || !input) return;

                const examples = {{ search_examples|tojson }};
                const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                const active = () => document.querySelector("[data-search-scope].active") || tabs[0];

                let step;
                const stop = () => {
                    clearTimeout(step);
                    input.placeholder = "";
                };

                const type = scheme => {
                    clearTimeout(step);
                    const names = examples[scheme] || [];
                    if (still || !names.length) {
                        input.placeholder = active().dataset.placeholder;
                        return;
                    }
                    input.placeholder = "";

                    let i = 0, at = 0, erasing = false;
                    const tick = () => {
                        if (document.activeElement === input || input.value) {
                            input.placeholder = "";
                            at = 0;
                            erasing = false;
                            step = setTimeout(tick, 600);
                            return;
                        }
                        const name = names[i % names.length];
                        at += erasing ? -1 : 1;
                        input.placeholder = name.slice(0, at);
                        let wait = erasing ? 25 : 55;
                        if (!erasing && at === name.length) {
                            erasing = true;
                            wait = 1800;
                        } else if (erasing && at === 0) {
                            erasing = false;
                            i++;
                            wait = 700;
                        }
                        step = setTimeout(tick, wait);
                    };
                    step = setTimeout(tick, 600);
                };

                input.addEventListener("focus", stop);
                input.addEventListener("blur", () => { if (!input.value) type(active().dataset.scheme); });
                type(tabs[0].dataset.scheme);

                tabs.forEach(tab => {
                    tab.addEventListener("click", event => {
                        event.preventDefault();
                        tabs.forEach(other => {
                            other.classList.remove("active");
                            other.removeAttribute("aria-current");
                        });
                        tab.classList.add("active");
                        tab.setAttribute("aria-current", "page");
                        form.action = tab.dataset.action;
                        type(tab.dataset.scheme);
                        if (random) random.href = tab.dataset.random;
                        document.querySelectorAll("[data-scheme-link]").forEach(link => {
                            link.href = link.dataset[tab.dataset.scheme] || link.dataset.cc;
                        });
                    });
                });
            })();
        </script>
    </main>
{% endblock %}
