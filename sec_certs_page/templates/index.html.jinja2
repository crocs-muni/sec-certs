{% extends "common/base.html.jinja2" %}
{% set canonical = True %}
{% block content %}
    <main class="main-home">
        <section class="hero-search" role="search">
            <div class="col-12 col-sm-10 mx-auto p-3 py-md-5">
                <h2>Search security certificates</h2>
                <p class="pt-2">
                    Explore Common Criteria, FIPS 140, and EUCC certificates in one place
                </p>
                <form method="get" action="{{ url_for("cc.merged_search") }}" id="hero-search-form" class="mt-3">
                    <label for="hero-search-input" class="visually-hidden">Search query</label>
                    <div class="d-flex gap-2 align-items-center flex-wrap flex-sm-nowrap">
                        <div class="position-relative flex-grow-1">
                            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"
                               aria-hidden="true"></i>
                            <input type="search" name="query" id="hero-search-input"
                                   class="form-control ps-5"
                                   placeholder="Product name, vendor, certificate ID, certificate title or keyword…">
                        </div>
                        <button type="submit" class="btn btn-primary flex-shrink-0">
                            Search
                        </button>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <span class="fw-semibold text-secondary">Search in:</span>
                        <div class="d-flex flex-wrap gap-2" role="group" aria-label="Search category">
                            <input type="radio" class="btn-check" name="hero-search-cat" id="hero-cat-cc"
                                   value="cc" autocomplete="off" checked>
                            <label class="btn btn-primary" for="hero-cat-cc">Common Criteria</label>

                            <input type="radio" class="btn-check" name="hero-search-cat" id="hero-cat-pp"
                                   value="pp" autocomplete="off">
                            <label class="btn btn-primary" for="hero-cat-pp">Protection Profiles</label>

                            <input type="radio" class="btn-check" name="hero-search-cat" id="hero-cat-eucc"
                                   value="eucc" autocomplete="off">
                            <label class="btn btn-primary" for="hero-cat-eucc">EUCC</label>

                            <input type="radio" class="btn-check" name="hero-search-cat" id="hero-cat-fips"
                                   value="fips" autocomplete="off">
                            <label class="btn btn-primary" for="hero-cat-fips">FIPS 140</label>
                        </div>
                    </div>
                </form>
            </div>
        </section>
        <script>
            (() => {
                const form = document.getElementById("hero-search-form");
                if (!form) return;
                const urls = {
                    cc: "{{ url_for("cc.merged_search") }}",
                    pp: "{{ url_for("pp.merged_search") }}",
                    eucc: "{{ url_for("eucc.merged_search") }}",
                    fips: "{{ url_for("fips.merged_search") }}",
                };
                form.addEventListener("submit", () => {
                    const checked = form.querySelector('input[name="hero-search-cat"]:checked');
                    if (checked && urls[checked.value]) {
                        form.action = urls[checked.value];
                    }
                });
            })();
        </script>

        <div class="row bg-darker-light p-3">
            <div class="col-12 col-sm-10 mx-auto">
                <h3 class="pt-2">Main features</h3>
                <div class="row g-4 py-4 row-cols-1 row-cols-lg-3">
                    <div class="feature col">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-search fa-fw"></i>
                        </div>
                        <h3>Unified search</h3>
                        <p>Search <a href="#hero-search-input">certificates</a> relevant for your product, filter
                            certificates by categories or status.
                            Explore the certificates without downloading and reading countless PDFs.
                        </p>
                        <p>
                            We download and process certificates
                            <a href="{{ url_for("cc.data") }}">weekly</a>, allowing you to search for your favorite Common
                            Criteria, EUCC and FIPS 140 products.
                        </p>
                        <div class="mt-auto">
                            <a href="{{ url_for("cc.merged_search") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Search in Common Criteria">
                                CC
                            </a>
                            <a href="{{ url_for("eucc.merged_search") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Search in EUCC">
                                EUCC
                            </a>
                            <a href="{{ url_for("pp.merged_search") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Search in Protection Profiles">
                                PP
                            </a>
                            <a href="{{ url_for("fips.merged_search") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Search in FIPS 140">
                                FIPS
                            </a>
                        </div>
                    </div>
                    <div class="feature col">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-network-wired fa-fw"></i>
                        </div>
                        <h3>Certificate references</h3>
                        <p>Explore the <a href="{{ url_for("fips.network") }}">references</a> between product
                            certificates in a graph. A certificate referencing
                            another certificate often means that its product is built atop of another security relevant
                            product.</p>
                        <p>We use regular expressions to create references between certificates, making it easy for you
                            to find relationships in our reference graphs or certificate details.</p>
                        <div class="mt-auto">
                            <a href="{{ url_for("cc.network") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Show Common Criteria references graph">
                                CC
                            </a>
                            <a href="{{ url_for("fips.network") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Show FIPS 140 references graph">
                                FIPS
                            </a>
                        </div>
                    </div>
                    <div class="feature col">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-bug fa-fw"></i>
                        </div>
                        <h3>Vulnerability investigation</h3>
                        <p>
                            Investigate the vulnerabilities affecting certified products.
                        </p>
                        <p>
                            We automatically map certificates to <abbr
                                title="Common Vulnerabilities and Exposures">CVE</abbr>
                            entries in NIST's National Vulnerability Database affecting them.
                            The information on relevant CVEs is displayed in the appropriate heuristics section
                            on pages of the affected certificates.
                        </p>
                        <div class="mt-auto">
                            <a href="{{ url_for("vuln.index", _anchor="cve") }}"
                               class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip"
                               data-bs-title="Search vulnerable certificates by CVE">
                                CVE
                            </a>
                            <a href="{{ url_for("vuln.index", _anchor="cpe") }}"
                               class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip"
                               data-bs-title="Search vulnerable certificates by CPE">
                                CPE
                            </a>
                        </div>
                    </div>
                    <div class="feature col">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-comments fa-fw"></i>
                        </div>
                        <h3>Explore certificates with AI</h3>
                        <p>Use our AI assistant to help you explore and understand
                            Common Criteria, EUCC and FIPS 140 certificates. Ask questions about a certificate
                            and let the AI guide you through the complex certification documents.
                        </p>
                        <div class="mt-auto">
                            <a href="{{ url_for("cc.merged_search") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Pick a certificate">
                                CC
                            </a>
                            <a href="{{ url_for("eucc.merged_search") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Pick a certificate">
                                EUCC
                            </a>
                            <a href="{{ url_for("pp.merged_search") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Pick a protection profile">
                                PP
                            </a>
                            <a href="{{ url_for("fips.merged_search") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Pick a certificate">
                                FIPS
                            </a>
                        </div>
                    </div>
                    <div class="feature col">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-chart-line fa-fw"></i>
                        </div>
                        <h3>Trend visualization</h3>
                        <p>
                            Explore our analysis of the evolving security certifications landscape.
                        </p>
                        <p>
                            We process certification PDFs into structured, machine-readable datasets, which are then
                            used to generate plots.
                            You can explore sample plots in the Analysis section.
                            Please note that these are preliminary findings - refer to our published
                            <a href="{{ url_for('about.research') }}">research</a>
                            for a more detailed analysis.

                        </p>
                        <div class="mt-auto">
                            <a href="{{ url_for("cc.analysis") }}"
                               class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip"
                               data-bs-title="Show Common Criteria analysis">
                                CC
                            </a>
                            <a href="{{ url_for("fips.analysis") }}"
                               class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip"
                               data-bs-title="Show FIPS 140 analysis">
                                FIPS
                            </a>
                        </div>
                    </div>
                    <div class="feature col">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-file-alt fa-fw"></i>
                        </div>
                        <h3>Open source & open data</h3>
                        <p>
                            Contribute to our code or download our extracted dataset in machine-readable format.
                        </p>
                        <p>
                            Each week, we collect thousands of certificate files, convert them into machine-readable
                            datasets,
                            and enrich them with additional metadata. Full datasets are available below, while
                            individual certificate
                            data can be accessed on each certificate's page.
                        </p>
                        <div class="mt-auto">
                            <a href="https://github.com/crocs-muni/sec-certs"
                               class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip"
                               data-bs-title="Show project source code">
                                GitHub
                            </a>
                            <a href="{{ url_for("cc.data") }}"
                               class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip"
                               data-bs-title="Show Common Criteria datasets">
                                CC
                            </a>
                            <a href="{{ url_for("eucc.data") }}"
                               class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip"
                               data-bs-title="Show EUCC datasets">
                                EUCC
                            </a>
                            <a href="{{ url_for("pp.data") }}"
                               class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip"
                               data-bs-title="Show Protection Profile datasets">
                                PP
                            </a>
                            <a href="{{ url_for("fips.data") }}"
                               class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip"
                               data-bs-title="Show FIPS 140 datasets">
                                FIPS
                            </a>
                        </div>
                    </div>
                    <div class="feature col">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-envelope fa-fw"></i>
                        </div>
                        <h3>Change notifications</h3>
                        <p>Subscribe to notifications about a vulnerability affecting a set of
                            certified products, all changes in a set of certified products or about new
                            certificates.</p>
                        {% if not config["SUBSCRIPTIONS_ENABLED"] %}
                            <p>Notification subscriptions are currently disabled.</p>
                        {% endif %}
                        <p>As a registered user, you can subscribe using the <span class="fa-stack fa-2x"
                                                                                   style="font-size: 0.8rem">
                            <i class="fas fa-square fa-stack-2x text-secondary"
                               style="vertical-align: middle"></i>
                            <i class="fas fa-envelope fa-stack-1x text-light"
                               style="vertical-align: middle"></i>
                        </span> button in certificate details.
                        </p>
                        {#
                        <p>Alternatively, use the update feed button <span class="fa-stack fa-2x"
                                                                           style="font-size: 0.8rem">
                            <i class="fas fa-square fa-stack-2x text-secondary"
                               style="vertical-align: middle"></i>
                            <i class="fas fa-feed fa-stack-1x text-light"
                               style="vertical-align: middle"></i>
                        </span> to get an ATOM feed of updates to a certificate.
                        </p>
                     #}
                    </div>
                    <div class="feature col">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-code fa-fw"></i>
                        </div>
                        <h3>Python library</h3>
                        <p>Everything on this site is built with our open-source Python library. Install it to
                            reproduce the datasets yourself, or plug the certification data straight into your own
                            analysis. The documentation includes a quick-start guide.</p>
                        <div class="mt-auto">
                            <a href="https://github.com/crocs-muni/sec-certs" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Show project source code">
                                GitHub
                            </a>
                            <a href="{{ url_for("docs.serve_docs", path="index.html") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Show documentation">
                                Docs
                            </a>
                            <a href="{{ url_for("about.changelog") }}" class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip" data-bs-title="Show changelog">
                                Changelog
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-10 mx-auto p-3 py-md-5">
            <div class="row mb-3 g-4 justify-content-between row-cols-1 row-cols-lg-2">
                <div class="col-12 col-sm-7 order-1 order-sm-0">
                    <h3>About sec-certs</h3>
                    <p class="pt-2">
                        We want to become the one-stop shop to explore the
                        <a href="{{ url_for("cc.index") }}">Common Criteria</a> /
                        <a href="{{ url_for("eucc.index") }}">EUCC</a> /
                        <a href="{{ url_for("fips.index") }}">FIPS 140</a>
                        certification ecosystem. We aggregate and annotate certification data, enabling you to perform
                        unified searches,
                        investigate <a href="{{ url_for("vuln.index") }}">vulnerabilities</a>,
                        analyze <a href="/dashboard/">trends</a>,
                        compare
                        <a href="{{ url_for("cc.compare", one_hashid="a5171efab0a32451", other_hashid="0b0b999b8665313b") }}">products</a>
                        side-by-side, subscribe to
                        certificate changes,
                        and take other actions on certified products.
                    </p>
                    <p class="pt-2">
                        The sec-certs tool is an ongoing research project by the Centre for Research on Cryptography
                        and Security. Learn more about our
                        <a href="{{ url_for("about.index") }}">team</a>
                        and
                        <a href="{{ url_for("about.research") }}">research</a>.
                    </p>
                </div>
                <div class="col-12 col-sm-5 order-0 order-sm-1 justify-content-center justify-content-sm-start d-flex">
                    <img src="{{ url_for("static", filename="img/logo.svg") }}" alt="sec-certs"
                         class="d-none d-xl-block mw-100"
                         style="filter: drop-shadow(0px 8px 16px rgba(0, 0, 0, 0.15)); margin: 2em;"/>
                    <img src="{{ url_for("static", filename="img/logo_badge.svg") }}" alt="sec-certs"
                         class="d-xl-none mw-100"
                         style="filter: drop-shadow(0px 8px 16px rgba(0, 0, 0, 0.15));"/>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
