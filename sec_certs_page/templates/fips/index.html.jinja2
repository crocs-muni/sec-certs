{% extends "common/base.html.jinja2" %}
{% set canonical = True %}

{% block content %}
    <main>
        <section class="hero-search">
            <div class="col-12 col-sm-10 mx-auto p-3 py-md-5">
                <h1>FIPS 140</h1>
                <p class="lead fw-light pt-2">
                    All of the certificates are sourced from the NIST CMVP (Cryptographic Module Validation Program) portal at
                    <a href="https://csrc.nist.gov/projects/cryptographic-module-validation-program/validated-modules/search/all"
                       target="_blank" rel="noopener">csrc.nist.gov</a>.
                    The site provides a search and HTML listing of the certified products with some metadata.
                    These listings were crawled (along with the certificates and security targets themselves) to gather the data provided here.
                </p>
            </div>
        </section>
        <section class="hero-search" role="search">
            <div class="col-12 col-sm-10 mx-auto p-3 py-md-3">
                <h2 class="h5">Search FIPS 140 certificates</h2>
                <form method="get" action="{{ url_for('.merged_search') }}" id="fips-hero-search-form" class="mt-2">
                    <label for="fips-hero-search-input" class="visually-hidden">Search query</label>
                    <div class="d-flex gap-2 align-items-center flex-wrap flex-sm-nowrap">
                        <div class="position-relative flex-grow-1">
                            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"
                               aria-hidden="true"></i>
                            <input type="search" name="query" id="fips-hero-search-input"
                                   class="form-control form-control-lg ps-5"
                                   placeholder="Module name, vendor, certificate number...">
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg flex-shrink-0">
                            Search
                        </button>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <span class="small fw-semibold text-secondary">Status:</span>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Status filter">
                            <input type="radio" class="btn-check" name="fips-hero-status" id="fips-status-all"
                                   value="" autocomplete="off" checked>
                            <label class="btn btn-primary" for="fips-status-all">All</label>

                            <input type="radio" class="btn-check" name="fips-hero-status" id="fips-status-active"
                                   value="active" autocomplete="off">
                            <label class="btn btn-primary" for="fips-status-active">Active</label>

                            <input type="radio" class="btn-check" name="fips-hero-status" id="fips-status-historical"
                                   value="historical" autocomplete="off">
                            <label class="btn btn-primary" for="fips-status-historical">Historical</label>

                            <input type="radio" class="btn-check" name="fips-hero-status" id="fips-status-revoked"
                                   value="revoked" autocomplete="off">
                            <label class="btn btn-primary" for="fips-status-revoked">Revoked</label>
                        </div>
                    </div>
                </form>
            </div>
        </section>
        <script>
            (() => {
                const form = document.getElementById("fips-hero-search-form");
                if (!form) return;
                form.addEventListener("submit", () => {
                    const checked = form.querySelector('input[name="fips-hero-status"]:checked');
                    if (checked && checked.value) {
                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = "status";
                        input.value = checked.value;
                        form.appendChild(input);
                    }
                });
            })();
        </script>

        <div class="row bg-darker-light p-3">
            <div class="col-12 col-sm-10 mx-auto">
                <div class="row my-5">
                    <div class="col-12 col-md-6">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-search fa-fw"></i>
                        </div>
                        <h2>Search</h2>
                        <p>We are converting all FIPS 140 certificates from PDFs into machine readable format.
                        You can use this website to search in our database for any FIPS 140 certificate, discover its extracted metadata, filter them and do much more.</p>
                        <a href="{{ url_for(".merged_search") }}" class="btn btn-primary">
                            Learn more <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="col-12 col-md-6 mt-4 mt-md-0">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fa fa-lightbulb" aria-hidden="true"></i>
                        </div>
                        <h2>Example</h2>
                        <p>No more talking. Have a look at the example certificate we have chosen for you. 
                        Discover extracted metadata and much more. Don't forget to search for your own certificates later!</p>
                        <a href="{{ url_for("fips.rand") }}" class="btn btn-outline-primary m-1 ms-0">
                            Random certificate
                        </a>
                        <a href="{{ url_for(".entry", hashid="1625f9db144171f7") }}" class="btn btn-primary m-1">
                            Show example <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                    
                </div>
            </div>
        </div>
        <div class="row p-3">
            <div class="col-12 col-sm-10 mx-auto">
                <div class="row my-5">
                    <div class="col-12 col-md-6">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-chart-line fa-fw"></i>
                        </div>
                        <h2>Analysis</h2>
                        <p>Which scheme is issuing certificates the most? Which certificate category is the most numerous?
                        You can find answers here and you can also make your own statistics with our prepared datasets.</p>
                        <a href="{{ url_for(".analysis") }}" class="btn btn-primary">
                            Learn more <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="col-12 col-md-6 mt-4 mt-md-0">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-network-wired fa-fw"></i>
                        </div>
                        <h2>References</h2>
                        <p>Wanted to know, what certificates are referencing yours and vice versa? We got you covered.
                        We are automatically adding references between certificates, which then creates big graph of references.
                        You can also see smaller reference graphs in certificate details.</p>
                        <a href="{{ url_for(".network") }}" class="btn btn-primary">
                            Learn more <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row bg-darker-light p-3">
            <div class="col-12 col-sm-10 mx-auto">
                <div class="row my-5">
                    <div class="col-12 col-md-6">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-tools fa-fw"></i>
                        </div>
                        <h2 class="anchor" id="mip-iut">MIP and IUT</h2>
                        <p>The FIPS 140 Modules In Process (MIP) and Implementations Under Test (IUT) lists provide
                            information about modules currently undergoing NIST CMVP evaluation. We process these lists
                            daily and provide a log of snapshots.</p>
                        <a href="{{ url_for(".mip_index") }}" role="button" class="mt-1 btn btn-primary"><i
                                class="fas fa-fw fa-list"></i>
                            MIP</a>
                        <a href="{{ url_for(".iut_index") }}" role="button" class="mt-1 btn btn-primary"><i
                                class="fas fa-fw fa-list"></i>
                            IUT
                        </a>
                    </div>
                    <div class="col-12 col-md-6 mt-4 mt-md-0">
                        <div class="feature-icon bg-primary bg-gradient">
                            <i class="fas fa-file-alt fa-fw"></i>
                        </div>
                        <h2>Data</h2>
                        <p>Want to process all FIPS 140 data on your own? Download our prepared datasets and analyse them.</p>
                        <a href="{{ url_for(".data") }}" class="btn btn-primary">
                            Learn more <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>       
        
    </main>
{% endblock %}
