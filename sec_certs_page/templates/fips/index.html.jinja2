{% extends "common/base.html.jinja2" %}
{% set canonical = True %}
{% from "include/utils.html.jinja2" import search_box %}

{% block content %}
    <main class="scheme-home">
        <div class="home-container px-3 px-md-4 pt-md-4">
            <div class="row g-4 justify-content-between mb-4">
                <div class="col-12 col-sm-7">
                    <h1 class="h2 mb-3">FIPS 140</h1>
                    <div style="max-width: 100ch">
                <p>
                    All of the certificates are sourced from the NIST CMVP (Cryptographic Module Validation Program)
                    portal at
                    <a href="https://csrc.nist.gov/projects/cryptographic-module-validation-program/validated-modules/search/all"
                       target="_blank" rel="noopener">csrc.nist.gov</a>.
                    The site provides a search and HTML listing of the certified products with some metadata.
                    These listings were crawled (along with PDFs of the certificates and security targets) to gather
                    the data provided here.
                </p>
                <p class="mb-0">
                    Search our database for FIPS 140 certificates, discover the extracted metadata and keywords,
                    filter them and use other advanced filtering.
                </p>
                    </div>
                </div>
                <div class="col-12 col-sm-5 d-flex justify-content-center align-items-start">
                    <img src="{{ url_for("static", filename="img/fips_logo.svg") }}" alt="FIPS 140"
                         class="part-logo mw-100" style="width: 10em"/>
                </div>
            </div>
        </div>
        {{ search_box("fips", "Search FIPS 140 certificates", "Module name",
                      url_for('.merged_search'), url_for('.rand')) }}
        <div class="home-band pt-3 pb-3 pb-md-4">
            <div class="home-container px-3 px-md-4">
                <h2 class="h5 mb-3">Main features</h2>
                <div class="row g-3 row-cols-1 row-cols-md-2 feature-grid">
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-chart-bar fa-fw"></i></span>
                                    <h3>Statistics Analysis</h3>
                                </div>
                                <p class="text-body-secondary">Which scheme is issuing certificates the most? Which certificate category is the most common? You can find answers here and you can also make your own statistics with our prepared datasets.</p>
                                <div class="mt-auto pt-3">
                                    <a href="{{ url_for('.analysis') }}" class="fw-semibold text-decoration-none">
                                        Explore statistics <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-project-diagram fa-fw"></i></span>
                                    <h3>Cross-references</h3>
                                </div>
                                <p class="text-body-secondary">Wanted to know, what certificates are referencing yours and vice versa? We got you covered. We are automatically adding references between certificates, which then creates big graph of references. You can also see smaller reference graphs in certificate details.</p>
                                <div class="mt-auto pt-3">
                                    <a href="{{ url_for('.network') }}" class="fw-semibold text-decoration-none">
                                        View reference graph <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card feature-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column p-3 p-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-file-alt fa-fw"></i></span>
                                    <h3>Data</h3>
                                </div>
                                <p class="text-body-secondary">Want to process all FIPS 140 data on your own? Download our prepared datasets and analyze them.</p>
                                <div class="mt-auto pt-3">
                                    <a href="{{ url_for('.data') }}" class="fw-semibold text-decoration-none">
                                        Download datasets <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card feature-card shadow-sm mt-3">
                    <div class="card-body p-3 p-lg-4">
                        <div class="row g-4">
                            <div class="col-12 col-md-8">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="feature-icon-chip"><i class="fas fa-wrench fa-fw"></i></span>
                                    <h3 class="anchor" id="mip-iut">MIP and IUT</h3>
                                </div>
                                <p class="text-body-secondary">The FIPS 140 <b>Modules In Process (MIP)</b> and
                                    <b>Implementations Under Test (IUT)</b> lists provide information about modules
                                    currently undergoing NIST CMVP evaluation. We process these lists daily and
                                    provide a log of snapshots.</p>
                                <p class="text-body-secondary">Use the overview to track which modules are in the
                                    evaluation pipeline, monitor status changes over time, and spot new entries
                                    before they become full certificates.</p>
                                <div class="pt-2 d-flex flex-wrap gap-3">
                                    <a href="{{ url_for('.mip_snapshot', id=fips_mip._id) if fips_mip else url_for('.mip_index') }}"
                                       class="fw-semibold text-decoration-none">
                                        Browse MIP <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                    <a href="{{ url_for('.iut_snapshot', id=fips_iut._id) if fips_iut else url_for('.iut_index') }}"
                                       class="fw-semibold text-decoration-none">
                                        Browse IUT <i class="fas fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                            <div class="col-12 col-md-4 d-flex flex-column gap-3 justify-content-center">
                                {% if fips_mip %}
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="fs-4 fw-bold text-primary">{{ fips_mip.total }}</span>
                                        <span class="text-body-secondary">Modules In Process</span>
                                    </div>
                                {% endif %}
                                {% if fips_iut %}
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="fs-4 fw-bold text-primary">{{ fips_iut.total }}</span>
                                        <span class="text-body-secondary">Under Test</span>
                                    </div>
                                {% endif %}
                                {% if fips_mip and fips_mip.last_updated %}
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="fs-4 fw-bold text-primary">{{ fips_mip.last_updated|fromisoformat|strftime("%d.%m.%Y") }}</span>
                                        <span class="text-body-secondary">Last updated</span>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
