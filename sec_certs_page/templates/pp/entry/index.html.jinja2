{% extends "common/base.html.jinja2" %}
{% set canonical = True %}
{% from "include/modals.html.jinja2" import compare_icon, chat_icon, chat_modal with context %}
{% from "include/entry.html.jinja2" import entry_card, cryptography_keywords, device_keywords, security_keywords, other_keywords, render_local_report, render_local_profile, render_file_metadata, render_updates, render_update_feed_button, render_raw_data, render_raw_data_button %}
{% from "cc/include.html.jinja2" import cc_keywords, render_eal, render_status, render_sars, render_sfrs, render_category %}
{% from "include/utils.html.jinja2" import render_process_state, render_share_buttons, notification_icon, notification_script with context %}
{% from "include/legal.html.jinja2" import certificate_note %}
{% set chat_documents = [
    {"value": "profile", "label": "Protection profile", "available": local_files.get(("profile", "txt"), false)},
    {"value": "report", "label": "Certification report", "available": local_files.get(("report", "txt"), false)},
] %}

{% block title %}
    <title>
        {{ profile["web_data"]["name"]|default("", true) + " | sec-certs.org" }}
    </title>
{% endblock %}
{% block metadata %}
    <meta property="twitter:card" content="summary"/>
    <meta property="twitter:site" content="@CRoCS_MUNI"/>
    <meta property="twitter:title" content="{{ profile["web_data"]["name"]|default("sec-certs.org", true) }}"/>
    <meta property="twitter:image" content="{{ url_for("static", filename="img/pp_card.png", _external=True) }}"/>
    <meta property="twitter:description"
          content="Common Criteria protection profile {{ profile["web_data"]["name"]|default("", true) }}"/>
    <meta property="og:title" content="{{ profile["web_data"]["name"]|default("sec-certs.org", true) }}"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="{{ url_for(".entry", hashid=hashid, _external=True) }}"/>
    <meta property="og:image" content="{{ url_for("static", filename="img/pp_card.png", _external=True) }}"/>
    <meta property="og:description"
          content="Common Criteria protection profile {{ profile["web_data"]["name"]|default("", true) }}"/>
    <meta property="og:site_name" content="sec-certs.org"/>
{% endblock %}

{% block left_navigation %}
    <div id="left-navigation" class="d-none d-md-block list-group list-group-flush list-group-numbered">
        <h4>Sections</h4>
        <a class="list-group-item list-group-item-action rounded" href="#web-info">Profile details</a>
        <a class="list-group-item list-group-item-action rounded" href="#report-info">Report</a>
        <a class="list-group-item list-group-item-action rounded" href="#profile-info">Profile</a>
        <a class="list-group-item list-group-item-action rounded" href="#reference-graph">References</a>
        <a class="list-group-item list-group-item-action rounded" href="#updates">Processing updates</a>
        <a class="list-group-item list-group-item-action rounded" href="#raw-data-head">Raw data</a>
    </div>
{% endblock %}

{% block content %}
    <main tabindex="0" class="shifted-section">
        {% include 'pp/entry/components/header.html.jinja2' %}

        {% include 'pp/entry/components/web_info.html.jinja2' %}

        {% include 'pp/entry/components/report_doc.html.jinja2' %}

        {% include 'pp/entry/components/profile_doc.html.jinja2' %}

        {% include 'pp/entry/components/references.html.jinja2' %}

        {% call entry_card(id="updates", title="Processing updates", icon="fa-clock-rotate-left", heading_extra=render_update_feed_button(hashid), tooltip="A log of how this entry's data changed across our periodic updates. Changes may reflect updates to the source listing or improvements in our own data extraction.") %}
            {{ render_updates("protection profile", diffs, diff_jsons, diff_renders) }}
        {% endcall %}

        {% call entry_card(id="raw-data-head", title="Raw data", icon="fa-code", heading_extra=render_raw_data_button(hashid)) %}
            {{ render_raw_data(json) }}
        {% endcall %}
        <script type="module">
            import {copyLinkToClipboard} from "{{ url_for('static', filename='clipboard.js') }}?{{ static_hash("clipboard.js") }}";
            import {initSectionNav} from "{{ url_for('static', filename='section_nav.js') }}?{{ static_hash("section_nav.js") }}";
            initSectionNav();

            $(".copy-on-click").on("click", function (e) {
                e.preventDefault();
                copyLinkToClipboard($(this));
            });

            window.certificate_data = {
                name: "{{ profile["web_data"]["name"]|default("", true) }}",
                hashid: "{{ hashid }}",
                type: "pp",
                url: "{{ url_for("pp.entry", hashid=hashid) }}"
            };
        </script>
        {{ notification_script(csrf_token) }}
    </main>
    {% if config["CHAT_ENABLED"] %}
        {{ chat_modal(chat_documents,
                      placeholders=["Describe this protection profile.",
                                    "What type of product does this protection profile cover?",
                                    "What assurance requirements does this protection profile mandate?",
                                    "What security functional requirements does this protection profile contain?",
                                    "When was this protection profile certified?"],
                      subject="protection profile") }}
    {% endif %}
{% endblock %}

{% block footer %}
    {{ super() }}
{% endblock %}
