{% extends "common/base.html.jinja2" %}
{% from "include/entry.html.jinja2" import entry_card, mobile_warning, render_cpe_uri, render_cve_impact %}
{% from "include/legal.html.jinja2" import cve_note %}
{% set canonical = True %}
{% set breadcrumb_title = True %}
{% block title %}
    <title>{{ cve["_id"] }} | sec-certs.org</title>
{% endblock %}
{% block metadata %}
    <meta property="description" content="{{ cve["_id"] }}"/>
    <meta property="twitter:card" content="summary"/>
    <meta property="twitter:site" content="@CRoCS_MUNI"/>
    <meta property="twitter:title" content="{{ cve["_id"] }}"/>
    <meta property="twitter:image" content="{{ url_for("static", filename="img/cve_card.png", _external=True) }}"/>
    <meta property="twitter:description" content="{{ cve["_id"] }}"/>
    <meta property="og:title" content="{{ cve["_id"] }}"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="{{ url_for(".cve", cve_id=cve["_id"], _external=True) }}"/>
    <meta property="og:image" content="{{ url_for("static", filename="img/cve_card.png", _external=True) }}"/>
    <meta property="og:description" content="{{ cve["_id"] }}"/>
    <meta property="og:site_name" content="sec-certs.org"/>
    <meta name="description" content="{{ cve["_id"] }}"/>
    <meta name="robots" content="noindex"/>
{% endblock %}

{% block content %}
    <main>
        <div class="home-container px-3 px-md-4 pt-4 pb-4">
            {{ mobile_warning() }}

            <h1 class="entry-title">{{ cve["_id"] }}</h1>
            <div class="d-flex gap-3 flex-wrap align-items-center pt-3 pb-3 mb-3">
                <a class="btn btn-outline-primary" role="button"
                   href="https://www.cve.org/CVERecord?id={{ cve["_id"] }}" target="_blank" rel="noopener"
                   data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Open the record at cve.org">
                    <i class="fas fa-external-link-alt"></i> cve.org
                </a>
                <a class="btn btn-outline-primary" role="button"
                   href="https://nvd.nist.gov/vuln/detail/{{ cve["_id"] }}" target="_blank" rel="noopener"
                   data-bs-toggle="tooltip" data-bs-placement="bottom"
                   data-bs-title="Open the record in NIST's National Vulnerability Database">
                    <i class="fas fa-external-link-alt"></i> NVD
                </a>
            </div>

            {% call entry_card(id="data", title="Vulnerability details", icon="fa-globe",
                               wrapper_class="", tooltip="As published in NIST's National Vulnerability Database.") %}
                <table class="table-sm table-borderless w-100">
                    <colgroup>
                        <col style="width: 30%"/>
                        <col style="width: 70%"/>
                    </colgroup>
                    <tbody>
                    <tr data-cs-name="Vulnerability ID">
                        <th scope="row">Vulnerability ID</th>
                        <td>{{ cve["_id"] }}</td>
                    </tr>
                    <tr data-cs-name="Published on">
                        <th scope="row">Published on</th>
                        <td>{{ cve["published_date"]|fromisoformat()|strftime("%d.%m.%Y %H:%M") }}</td>
                    </tr>
                    <tr data-cs-name="Severity">
                        <th scope="row">Severity</th>
                        <td>{{ render_cve_impact(cve["cvss"]["severity"]) }}</td>
                    </tr>
                    </tbody>
                </table>
            {% endcall %}

            {%- set cpe_count = namespace(total=0) %}
            {%- for has_cpes, first, second in vuln_configs %}
                {%- set cpe_count.total = cpe_count.total + (first|length) + (second|length if second else 0) %}
            {%- endfor %}
            {% call entry_card(id="vulnerable-cpes", title="Vulnerable configurations", icon="fa-list-ul",
                               wrapper_class="",
                               heading_extra=("%d CPEs" % cpe_count.total) if vuln_configs else None,
                               tooltip="The configurations this vulnerability applies to, as CPE identifiers.") %}
                {% if vuln_configs %}
                    <ul class="list-unstyled mb-0 {% if cpe_count.total > 12 %}scroll-list{% endif %}"
                        data-cs-name="Vulnerable configurations">
                        {% for has_cpes, first, second in vuln_configs %}
                            <li class="{% if not loop.first %}pt-2 mt-2 border-top{% endif %}">
                                <ul class="list-unstyled mb-0">
                                    {% for cpe in first %}
                                        <li class="cpe-uri">
                                            {% if has_cpes %}
                                                <a href="{{ url_for(".cpe", cpe_id=cpe) }}">{{ render_cpe_uri(cpe) }}</a>
                                            {% else %}
                                                {{ render_cpe_uri(cpe) }}
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                                {% if second %}
                                    <div class="small text-secondary ps-3 pt-1">running on</div>
                                    <ul class="list-unstyled mb-0 ps-3">
                                        {% for cpe in second %}
                                            <li class="cpe-uri">
                                                {% if has_cpes %}
                                                    <a href="{{ url_for(".cpe", cpe_id=cpe) }}">{{ render_cpe_uri(cpe) }}</a>
                                                {% else %}
                                                    {{ render_cpe_uri(cpe) }}
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="mb-0">This CVE has no vulnerable configurations linked.</p>
                {% endif %}
            {% endcall %}

            {% call entry_card(id="vulnerable-certs", title="Vulnerable certificates", icon="fa-certificate",
                               wrapper_class="",
                               tooltip="Certificates we link to this vulnerability through their CPE matches.") %}
                {% if cc_certs or fips_certs %}
                    {{ cve_note() }}
                {% endif %}

                {% if cc_certs %}
                    <div class="mb-3" data-cs-name="Vulnerable CC certificates">
                        <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                            <h3 class="h6 mb-0">Common Criteria certificates</h3>
                            <a href="{{ url_for("cc.network", search="cve", cve=cve["_id"]) }}"
                               class="btn btn-primary btn-sm" role="button"
                               data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Display reference graph with affected certificates highlighted">
                                <i class="fas fa-project-diagram"></i> Display network
                            </a>
                        </div>
                        <ul class="mb-0">
                            {% for cert in cc_certs %}
                                <li>
                                    <a href="{{ url_for("cc.entry", hashid=cert["_id"]) }}">{{ cert["name"]|default("", true) }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if fips_certs %}
                    <div class="mb-3" data-cs-name="Vulnerable FIPS certificates">
                        <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                            <h3 class="h6 mb-0">FIPS 140 certificates</h3>
                            <a href="{{ url_for("fips.network", search="cve", cve=cve["_id"]) }}"
                               class="btn btn-primary btn-sm" role="button"
                               data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Display reference graph with affected certificates highlighted">
                                <i class="fas fa-project-diagram"></i> Display network
                            </a>
                        </div>
                        <ul class="mb-0">
                            {% for cert in fips_certs %}
                                <li>
                                    <a href="{{ url_for("fips.entry", hashid=cert["_id"]) }}">{{ cert|fips_name|default("", true) }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if not cc_certs and not fips_certs %}
                    <p class="mb-0">This CVE has no assigned vulnerable Common Criteria or FIPS 140 certificates.</p>
                {% endif %}
            {% endcall %}
        </div>
    </main>
{% endblock %}
