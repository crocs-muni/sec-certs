{% extends "common/base.html.jinja2" %}
{% from "include/entry.html.jinja2" import entry_card, mobile_warning, render_cves %}
{% from "include/legal.html.jinja2" import cpe_note %}
{% set canonical = True %}
{% set breadcrumb_title = True %}
{% block title %}
    <title>{{ cpe["_id"] }} | sec-certs.org</title>
{% endblock %}
{% block metadata %}
    <meta property="twitter:card" content="summary"/>
    <meta property="twitter:site" content="@CRoCS_MUNI"/>
    <meta property="twitter:title" content="{{ cpe["_id"] }}"/>
    <meta property="twitter:image" content="{{ url_for("static", filename="img/cpe_card.png", _external=True) }}"/>
    <meta property="twitter:description" content="{{ cpe["_id"] }}"/>
    <meta property="og:title" content="{{ cpe["_id"] }}"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="{{ url_for(".cpe", cpe_id=cpe["_id"], _external=True) }}"/>
    <meta property="og:image" content="{{ url_for("static", filename="img/cpe_card.png", _external=True) }}"/>
    <meta property="og:description" content="{{ cpe["_id"] }}"/>
    <meta property="og:site_name" content="sec-certs.org"/>
    <meta name="description" content="{{ cpe["_id"] }}"/>
    <meta name="robots" content="noindex"/>
{% endblock %}

{% block content %}
    <main>
        <div class="home-container px-3 px-md-4 pt-md-4 pb-4">
            {{ mobile_warning() }}

            <h1 class="entry-title">{{ cpe["title"]|default(cpe["_id"], true) }}</h1>
            <div class="d-flex gap-3 flex-wrap align-items-center pt-3 pb-3 mb-3">
                <a class="btn btn-outline-primary" role="button"
                   href="https://nvd.nist.gov/products/cpe/search/results?namingFormat=2.3&orderBy=CPEURI&keyword={{ cpe["uri"] }}"
                   target="_blank" rel="noopener"
                   data-bs-toggle="tooltip" data-bs-placement="bottom"
                   data-bs-title="Open the configuration in NIST's National Vulnerability Database">
                    <i class="fas fa-external-link-alt"></i> NVD
                </a>
            </div>

            {% call entry_card(id="data", title="Configuration details", icon="fa-globe", wrapper_class="",
                               tooltip="As published in NIST's National Vulnerability Database.") %}
                <table class="table-sm table-borderless w-100">
                    <colgroup>
                        <col style="width: 30%"/>
                        <col style="width: 70%"/>
                    </colgroup>
                    <tbody>
                    {% if cpe["title"] %}
                        <tr data-cs-name="CPE title">
                            <th scope="row">CPE title</th>
                            <td>{{ cpe["title"] }}</td>
                        </tr>
                    {% endif %}
                    <tr data-cs-name="URI">
                        <th scope="row">URI</th>
                        <td>{{ cpe["uri"] }}</td>
                    </tr>
                    </tbody>
                </table>
            {% endcall %}

            {% call entry_card(id="linked-cves", title="Linked CVEs", icon="fa-bug", wrapper_class="",
                               heading_extra=("%d CVEs" % cves|length) if cves else None,
                               tooltip="Vulnerabilities that list this configuration as affected.") %}
                {% if cves %}
                    {{ render_cves(cves) }}
                {% else %}
                    <p class="mb-0">This CPE has no linked CVEs.</p>
                {% endif %}
            {% endcall %}

            {% call entry_card(id="matched-certs", title="Matched certificates", icon="fa-certificate",
                               wrapper_class="",
                               tooltip="Certificates we matched to this configuration.") %}
                {% if cc_certs or fips_certs %}
                    {{ cpe_note() }}
                {% endif %}

                {% if cc_certs %}
                    <div class="mb-3" data-cs-name="Matched CC certificates">
                        <h3 class="h6 mb-2">Common Criteria certificates</h3>
                        <ul class="mb-0">
                            {% for cert in cc_certs %}
                                <li>
                                    <a href="{{ url_for("cc.entry", hashid=cert["_id"]) }}">{{ cert["name"]|default("", true) }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if fips_certs %}
                    <div class="mb-3" data-cs-name="Matched FIPS certificates">
                        <h3 class="h6 mb-2">FIPS 140 certificates</h3>
                        <ul class="mb-0">
                            {% for cert in fips_certs %}
                                <li>
                                    <a href="{{ url_for("fips.entry", hashid=cert["_id"]) }}">{{ cert|fips_name|default("", true) }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if not cc_certs and not fips_certs %}
                    <p class="mb-0">This CPE has no matched certificates.</p>
                {% endif %}
            {% endcall %}
        </div>
    </main>
{% endblock %}
