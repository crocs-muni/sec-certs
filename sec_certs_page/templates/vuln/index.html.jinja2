{% extends "common/base.html.jinja2" %}
{% set canonical = True %}

{% block content %}
    <main class="scheme-home">
        <section>
            <div class="col-12 col-sm-10 mx-auto p-3 pt-md-5 pb-md-4">
                <h1>Vulnerability information</h1>
                <p class="pt-2">Vulnerabilities can affect certified devices. We use the data provided
                    by MITRE in the form of the CVE database as well as data provided by NIST in its NVD to map
                    vulnerabilities to certified products.</p>
                <p class="pt-2">We are linking Common Criteria and FIPS 140 certificates to vulnerabilities.
                    You can also search for a vulnerability and check if your certificate can be affected or not.</p>
            </div>
        </section>
        <section class="col-12 col-sm-10 mx-auto p-3 mb-3 mb-md-4" role="search">
            <div class="card shadow-sm">
                <div class="card-body p-3 p-md-4">
                    <h2 class="h5">Search vulnerabilities</h2>
                    <form method="get" action="{{ url_for('.cve_search') }}" id="vuln-hero-search-form" class="mt-2">
                        <label for="vuln-hero-search-input" class="visually-hidden">Search query</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="search" name="query" id="vuln-hero-search-input"
                                   class="form-control flex-grow-1"
                                   placeholder="CVE ID">
                            <button type="submit" class="btn btn-primary flex-shrink-0">
                                <i class="fas fa-search me-1"></i>Search
                            </button>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                            <span class="fw-semibold text-secondary">Search in:</span>
                            <div class="d-flex flex-wrap gap-2" role="group" aria-label="Search category">
                                <input type="radio" class="btn-check" name="vuln-search-cat" id="vuln-cat-cve"
                                       value="cve" autocomplete="off" checked>
                                <label class="btn btn-outline-primary" for="vuln-cat-cve">CVE</label>

                                <input type="radio" class="btn-check" name="vuln-search-cat" id="vuln-cat-cpe"
                                       value="cpe" autocomplete="off">
                                <label class="btn btn-outline-primary" for="vuln-cat-cpe">CPE</label>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </section>
        <script>
            (() => {
                const form = document.getElementById("vuln-hero-search-form");
                if (!form) return;
                const input = document.getElementById("vuln-hero-search-input");
                const cats = {
                    cve: {url: "{{ url_for('.cve_search') }}", placeholder: "CVE ID"},
                    cpe: {url: "{{ url_for('.cpe_search') }}", placeholder: "Vendor, product"},
                };
                const selected = () => {
                    const checked = form.querySelector('input[name="vuln-search-cat"]:checked');
                    return checked ? cats[checked.value] : null;
                };
                form.addEventListener("change", () => {
                    const cat = selected();
                    if (cat) input.placeholder = cat.placeholder;
                });
                form.addEventListener("submit", () => {
                    const cat = selected();
                    if (cat) form.action = cat.url;
                });
            })();
        </script>

        <div class="col-12 col-sm-10 mx-auto p-3 pb-md-5">
            <div class="card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="feature-icon-sm bg-primary bg-gradient mb-0">
                            <i class="fas fa-file-alt fa-fw"></i>
                        </div>
                        <h2 class="mb-0">Data</h2>
                    </div>
                    <p>Want to see the dataset of vulnerabilities, which we are linking to certificates? Download it here.</p>
                    <a href="{{ url_for('.data') }}" class="btn btn-primary">Download datasets →</a>
                </div>
            </div>
        </div>

    </main>
{% endblock %}
